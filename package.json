{
  "name": "agentic-field-kit",
  "version": "1.0.0",
  "description": "Agentic Field Kit - provision, install, and demo agentic AI workloads on Istio Ambient Mesh",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "agentic": "./src/cli.js"
  },
  "scripts": {
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "start": "bun run src/cli.js",
    "app:deploy": "bun run src/cli.js app deploy",
    "app:list": "bun run src/cli.js app list",
    "usecase:list": "bun run src/cli.js usecase list",
    "usecase:deploy": "bun run src/cli.js usecase deploy",
    "usecase:clean": "bun run src/cli.js usecase clean",
    "check-deps": "bun run src/cli.js check-deps",
    "base:provision": "bun run src/cli.js base provision",
    "base:destroy": "bun run src/cli.js base destroy",
    "base:install": "bun run src/cli.js base install-agentic",
    "base:status": "bun run src/cli.js base status",
    "profile:list": "bun run src/cli.js profile list"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.2",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "execa": "^8.0.1",
    "figlet": "^1.7.0",
    "glob": "^13.0.6",
    "inquirer": "^9.2.12",
    "js-yaml": "^4.1.0",
    "log-symbols": "^7.0.0",
    "marked": "^18.0.10",
    "ora": "^8.0.1",
    "string-width": "^8"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.9.6"
  }
}
