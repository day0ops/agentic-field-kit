[0.594, "o", "\u001b[36m     _                    _   _      \u001b[39m\r\n\u001b[36m    / \\   __ _  ___ _ __ | |_(_) ___ \u001b[39m\r\n\u001b[36m   / _ \\ / _` |/ _ \\ '_ \\| __| |/ __|\u001b[39m\r\n\u001b[36m  / ___ \\ (_| |  __/ | | | |_| | (__ \u001b[39m\r\n\u001b[36m /_/   \\_\\__, |\\___|_| |_|\\__|_|\\___|\u001b[39m\r\n\u001b[36m         |___/                       \u001b[39m\r\n"]
[0.001, "o", "\u001b[90m  Agentic Field Kit v0.1.0\u001b[39m\r\n\u001b[90m\u001b[39m\r\n"]
